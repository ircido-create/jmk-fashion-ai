# Copie este arquivo para .env (que fica fora do git) e preencha.

# Token que o JMKSYSTEM manda no header Authorization de cada chamada.
# Gere um valor longo e aleatório. Na virada, ele passa a ser o valor do
# segredo BUBBLEWHATS_TOKEN no Lovable (Cloud -> Secrets).
API_TOKEN=

# URL pública deste worker, a que o túnel entrega (sem barra no fim).
# Entra no payload como o endereço de onde o webhook baixa a mídia recebida.
# Ex.: https://whats-jmk.trycloudflare.com
BASE_PUBLICA=

# Endereço do webhook do JMKSYSTEM, COM o ?k=<segredo>.
# Normalmente não precisa preencher: o próprio sistema registra pelo
# POST /config (botão "Reconfigurar webhook" do painel). Serve para teste.
# Sem o ?k= o webhook recusa tudo com 404.
WEBHOOK_URL=

# Receber mensagens de grupo (hoje boa parte do volume vem de grupo de fornecedor).
RECEBER_GRUPOS=true

# Caminho do Chrome, se não for o padrão.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Portas locais. A API é a que o túnel expõe; a do QR fica só no PC.
PORTA_API=8098
PORTA_QR=8099

# Espaçamento entre envios, em milissegundos. Rajada é o que leva a bloqueio.
GAP_MIN_MS=3000
GAP_MAX_MS=8000
